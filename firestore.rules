rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // New reading-only namespace. Merge this block carefully into existing rules.
    // A broad legacy allow must never also match readingUsers.
    match /readingUsers/{uid}/progress/{lessonId} {
      function owner() { return request.auth != null && request.auth.uid == uid; }
      function validProgress() {
        let d = request.resource.data;
        return lessonId in ['an-va-khu-vuon', 'meo-ben-cua-so', 'quyen-sach-cua-lan', 'bua-sang-cua-bin', 'qua-bong-trong-san', 'chiec-non-cua-ba', 'sau-con-mua']
          && d.keys().hasAll(['lessonId', 'score', 'total', 'completed', 'completedAt'])
          && d.keys().hasOnly(['lessonId', 'score', 'total', 'completed', 'completedAt'])
          && d.lessonId == lessonId
          && d.score is int && d.score >= 0 && d.score <= 3
          && d.total == 3 && d.completed == true
          && d.completedAt == request.time;
      }
      allow read, delete: if owner();
      allow create, update: if owner() && validProgress();
    }
    // Everything else is denied in this standalone reference file.
    // Preserve any existing project rules separately when deploying.
  }
}
